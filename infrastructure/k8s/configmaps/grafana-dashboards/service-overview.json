{
  "title": "Service Overview",
  "uid": "service-overview",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["schoolrail", "services"],
  "timezone": "utc",
  "editable": true,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "axisCenteredZero": false, "axisColorMode": "text" },
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\"}[5m])) by (service)",
          "legendFormat": "{{ service }}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "axisCenteredZero": false, "axisColorMode": "text" },
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\",service=~\"$service\"}[5m])) by (service) / sum(rate(http_requests_total{service=~\"$service\"}[5m])) by (service) * 100",
          "legendFormat": "{{ service }}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 Latency by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "axisCenteredZero": false, "axisColorMode": "text" },
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le, service))",
          "legendFormat": "{{ service }}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Status Codes Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\"}[5m])) by (status)",
          "legendFormat": "{{ status }}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU Usage by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "axisCenteredZero": false, "axisColorMode": "text" },
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\",pod=~\"$service.*\"}[5m])) by (pod) / sum(kube_pod_container_resource_limits_cpu_cores{pod=~\"$service.*\"}) by (pod) * 100",
          "legendFormat": "{{ pod }}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 6,
      "title": "Memory Usage by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "axisCenteredZero": false, "axisColorMode": "text" },
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container!=\"\",pod=~\"$service.*\"}) by (pod) / sum(kube_pod_container_resource_limits_memory_bytes{pod=~\"$service.*\"}) by (pod) * 100",
          "legendFormat": "{{ pod }}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "sparkline",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(http_requests_active{service=~\"$service\"})",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Pod Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "sparkline",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\",namespace=~\"schoolrail-.*\",pod=~\"$service.*\"})",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 9,
      "title": "Average Response Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "sparkline",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{service=~\"$service\"}[5m])) / sum(rate(http_request_duration_seconds_count{service=~\"$service\"}[5m]))",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 10,
      "title": "Upstream Timeout Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "sparkline",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"504|408\",service=~\"$service\"}[5m]))",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 11,
      "title": "gRPC Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{grpc_service=~\"$grpc_service\"}[5m])) by (grpc_service, grpc_method)",
          "legendFormat": "{{ grpc_service }} / {{ grpc_method }}",
          "interval": "15s"
        }
      ]
    },
    {
      "id": 12,
      "title": "gRPC Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handled_total{grpc_code!=\"OK\",grpc_service=~\"$grpc_service\"}[5m])) by (grpc_service, grpc_method) / sum(rate(grpc_server_handled_total{grpc_service=~\"$grpc_service\"}[5m])) by (grpc_service, grpc_method) * 100",
          "legendFormat": "{{ grpc_service }} / {{ grpc_method }}",
          "interval": "15s"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=~\"schoolrail-.*\"}, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "grpc_service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(grpc_server_handled_total, grpc_service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  }
}

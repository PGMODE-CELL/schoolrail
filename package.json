{
  "name": "schoolrail",
  "version": "2.0.0",
  "description": "SchoolRail — The free, open-source alternative to expensive school transportation software. Multi-tenant, microservice architecture, offline-first mobile, scales to 1M+ schools.",
  "author": "SchoolRail Team",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/schoolrail/schoolrail.git"
  },
  "bugs": {
    "url": "https://github.com/schoolrail/schoolrail/issues"
  },
  "homepage": "https://github.com/schoolrail/schoolrail#readme",
  "keywords": [
    "school-bus",
    "school-transportation",
    "bus-tracking",
    "gps-tracking",
    "student-safety",
    "fleet-management",
    "route-optimization",
    "school-management",
    "edtech",
    "fastapi",
    "nextjs",
    "react-native",
    "multi-tenant",
    "microservices",
    "offline-first",
    "kubernetes",
    "terraform",
    "helm"
  ],
  "workspaces": [
    "admin",
    "parent-app",
    "driver-app"
  ],
  "scripts": {
    "dev": "docker compose up -d",
    "dev:build": "docker compose up --build -d",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "admin": "cd admin && npm run dev",
    "admin:install": "cd admin && npm install",
    "admin:build": "cd admin && npm run build",
    "admin:lint": "cd admin && npm run lint",
    "parent-app": "cd parent-app && expo start",
    "parent-app:install": "cd parent-app && npm install",
    "driver-app": "cd driver-app && expo start",
    "driver-app:install": "cd driver-app && npm install",
    "install:all": "cd admin && npm install && cd ../parent-app && npm install && cd ../driver-app && npm install",
    "lint": "cd admin && npm run lint",
    "typecheck": "cd admin && npx tsc --noEmit",
    "test:admin": "cd admin && npm run test",
    "help": "echo 'SchoolRail v2.0.0 - Open Source School Transportation Platform. See ARCHITECTURE.md for details.'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.11"
  }
}

# SchoolRail Configuration
# Copy to .env and customize

# Database (Shared global registry)
DATABASE_URL=postgresql+asyncpg://schoolrail:schoolrail@localhost:5432/schoolrail

# Redis (Cache + Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Event Bus)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT (RS256 — use Vault in production)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# HashiCorp Vault (secrets management)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=schoolrail

# S3/MinIO (file storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=schoolrail

# SMTP (email — MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@schoolrail.com

# FCM (push notifications)
FCM_SERVER_KEY=

# SSO / OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# API Gateway
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml

# Feature Flags
ENABLE_ASYNC_ROUTE_OPTIMIZATION=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_SSO=false

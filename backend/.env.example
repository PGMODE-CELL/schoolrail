# SchoolRail Environment Configuration
# ======================================
# Copy this file to .env and update with your values

# ====================
# APP CONFIGURATION
# ====================
APP_NAME=SchoolRail
APP_VERSION=1.0.0
DEBUG=true
PORT=3001

# ====================
# DATABASE
# ====================
DATABASE_URL=sqlite:///./schoolrail.db

# ====================
# SECURITY
# ====================
SECRET_KEY=schoolrail-production-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====================
# CORS
# ====================
CORS_ORIGINS=*

# ====================
# SMS CONFIGURATION (MSG91)
# ====================
SMS_ENABLED=false
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
SMS_SENDER_ID=SCHOOL

# ====================
# EMAIL CONFIGURATION (SMTP)
# ====================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@schoolrail.com

# ====================
# PUSH NOTIFICATIONS (FCM)
# ====================
PUSH_ENABLED=false
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=your_firebase_project_id

# ====================
# WHATSAPP (Twilio)
# ====================
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_FROM_NUMBER=whatsapp:+1234567890

# ====================
# PAYMENT GATEWAY (Razorpay)
# ====================
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ====================
# PAYMENT GATEWAY (Stripe)
# ====================
STRIPE_API_KEY=sk_test_your_stripe_key

# ====================
# PAYMENT URLs
# ====================
PAYMENT_SUCCESS_URL=https://schoolrail.com/payment/success
PAYMENT_CANCEL_URL=https://schoolrail.com/payment/cancel

# ====================
# GPS SETTINGS
# ====================
GPS_UPDATE_INTERVAL=30
GPS_RETENTION_DAYS=90
MAX_SPEED_LIMIT=80

# ====================
# GEOFENCING
# ====================
GEOFENCE_RADIUS_METERS=100
GEOFENCE_ALERT_ENABLED=true